<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <!-- Plain platform theme: the app is a single full-screen WebView, so it
       needs no AppCompat / Avalonia styling. -->
  <style name="MyTheme.NoActionBar" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
    <item name="android:windowBackground">@drawable/splash_screen</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
  </style>
</resources>
